<Application x:Class="OmokLan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OmokLan"
             xmlns:views="clr-namespace:OmokLan.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:BoolToVisibility x:Key="BoolToVisibility" />
            <views:NotNullToVisibility x:Key="NotNullToVisibility" />
            <views:AvatarToBrushConverter x:Key="AvatarToBrush" />
            <views:AvatarToSymbolConverter x:Key="AvatarToSymbol" />
            <views:AvatarToNameConverter x:Key="AvatarToName" />
            <views:StoneToTextConverter x:Key="StoneToText" />
            <views:TimerColorConverter x:Key="TimerColor" />
            <views:PresenceToBrush x:Key="PresenceToBrush" />
            <views:PresenceToText x:Key="PresenceToText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
