<Window x:Class="OmokLan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:OmokLan.ViewModels"
        xmlns:views="clr-namespace:OmokLan.Views"
        mc:Ignorable="d"
        Title="LAN 오목 (OmokLan)"
        Height="840" Width="1180"
        MinHeight="720" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Bg}"
        Foreground="{StaticResource B.Text}"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <views:BoolToVisibility x:Key="BoolToVisibility" />
        <views:AvatarToBrushConverter x:Key="AvatarToBrush" />
        <views:AvatarToSymbolConverter x:Key="AvatarToSymbol" />

        <!-- ViewModel -> View 자동 매핑 템플릿 -->
        <DataTemplate DataType="{x:Type viewmodels:LobbyViewModel}">
            <views:LobbyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:GameViewModel}">
            <views:GameView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource B.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 커스텀 타이틀바 -->
        <Border Grid.Row="0" Background="#12162A" BorderBrush="#222847" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 좌측: 로고 및 타이틀 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="⚫⚪" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="LAN OMOK" FontSize="14" FontWeight="Black" Foreground="#ECEEFA" VerticalAlignment="Center" />
                    <Border Background="#208B5CF6" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="폐쇄망 P2P" FontSize="10" FontWeight="SemiBold" Foreground="#A78BFA" />
                    </Border>
                    <TextBlock Text="{Binding LocalIp, StringFormat='내 IP: {0}'}"
                               FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- 중앙 빈 공간: 드래그 이동 영역 -->

                <!-- 우측: 내 프로필 버튼 (언제든 닉네임/아바타 편집 가능) -->
                <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}"
                        Command="{Binding OpenProfileModalCommand}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="12"
                                Background="{Binding CurrentAvatar, Converter={StaticResource AvatarToBrush}}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CurrentAvatar, Converter={StaticResource AvatarToSymbol}}"
                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding CurrentNick}" FontSize="12" FontWeight="Bold" Foreground="#ECEEFA" VerticalAlignment="Center" />
                        <TextBlock Text="✏️" FontSize="10" Foreground="#8C92B8" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 윈도우 조작 버튼 (최소화, 최대화, 닫기) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Caption}" Click="OnMinimizeClick" ToolTip="최소화">
                        <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" SnapsToDevicePixels="True" />
                    </Button>
                    <Button Style="{StaticResource Btn.Caption}" Click="OnMaximizeRestoreClick" ToolTip="최대화 / 원래 크기로">
                        <Path Data="M 0.5,0.5 L 9.5,0.5 9.5,9.5 0.5,9.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" SnapsToDevicePixels="True" />
                    </Button>
                    <Button Style="{StaticResource Btn.CaptionClose}" Click="OnCloseClick" ToolTip="닫기">
                        <Path Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" SnapsToDevicePixels="True" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 메인 콘텐츠 영역 (LobbyView / GameView) -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />

        <!-- 프로필 편집 다이얼로그 모달 오버레이 -->
        <views:ProfileView Grid.RowSpan="2"
                           DataContext="{Binding ProfileEditVm}"
                           Visibility="{Binding DataContext.IsProfileModalOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />

        <!-- 전역 플로팅 토스트 알림 바 -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,32" Background="#F21E2340" BorderBrush="#38BDF8" BorderThickness="1.5"
                CornerRadius="16" Padding="20,12"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#38BDF8" Opacity="0.5" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="💡 " FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ToastText}" FontSize="13" FontWeight="SemiBold" Foreground="#ECEEFA" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
