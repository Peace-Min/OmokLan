<UserControl x:Class="OmokLan.Views.CoinTossControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:OmokLan.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <views:AvatarToBrushConverter x:Key="AvatarToBrush" />
        <views:AvatarToSymbolConverter x:Key="AvatarToSymbol" />
    </UserControl.Resources>

    <!-- 배경 암전 블러 오버레이 -->
    <Grid Background="#D0080B16">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="540" Height="480"
                Background="#EE14192D"
                BorderBrush="#60E2B857"
                BorderThickness="2"
                CornerRadius="28"
                Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#F59E0B" Opacity="0.5" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 헤더 텍스트 -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="⚔️ 흑(선공) 결정 코인 토스 ⚔️"
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FDE68A" Offset="0" />
                                <GradientStop Color="#F59E0B" Offset="1" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="코인이 공중으로 회전하여 선공을 결정합니다!"
                               FontSize="13" Foreground="#94A3B8"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <!-- 코인 토스 애니메이션 영역 -->
                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="240" Height="240">

                    <!-- 황금빛 아우라 펄스 -->
                    <Ellipse x:Name="AuraPulse" Width="220" Height="220" Opacity="0.6">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#A0F59E0B" Offset="0.3" />
                                <GradientStop Color="#30FBBF24" Offset="0.7" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="AuraScale" CenterX="110" CenterY="110" ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- 코인 본체 (플립 회전 및 점프 Transform) -->
                    <Grid x:Name="CoinContainer" Width="180" Height="180" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CoinScaleX" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="CoinBounceY" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- 코인 외곽 골드 프레임 테두리 -->
                        <Ellipse Width="180" Height="180" StrokeThickness="8">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFBEB" Offset="0" />
                                    <GradientStop Color="#F59E0B" Offset="0.4" />
                                    <GradientStop Color="#B45309" Offset="0.8" />
                                    <GradientStop Color="#FDE68A" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1E2340" Offset="0" />
                                    <GradientStop Color="#0F172A" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="#F59E0B" Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- 코인 전면: ⚫ 흑 (선공) -->
                        <Grid x:Name="FrontFace" Visibility="Visible">
                            <!-- 흑돌 베이스 입체 구체 -->
                            <Ellipse Width="150" Height="150">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.32,0.32" GradientOrigin="0.32,0.32" RadiusX="0.75" RadiusY="0.75">
                                        <GradientStop Color="#4B5563" Offset="0" />
                                        <GradientStop Color="#1E293B" Offset="0.35" />
                                        <GradientStop Color="#090D16" Offset="0.8" />
                                        <GradientStop Color="#000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FDE68A" Offset="0" />
                                        <GradientStop Color="#B45309" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚫" FontSize="44" HorizontalAlignment="Center" Foreground="#F59E0B" />
                                <TextBlock Text="흑 (선공)" FontSize="18" FontWeight="Black" Foreground="#FDE68A" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="F I R S T   M O V E" FontSize="9" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center" />
                            </StackPanel>
                            <!-- 반사 하이라이트 -->
                            <Path Data="M 24,42 A 70,70 0 0,1 126,42 A 60,26 0 0,0 24,42"
                                  Fill="#30FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" />
                        </Grid>

                        <!-- 코인 후면: ⚪ 백 (후공) -->
                        <Grid x:Name="BackFace" Visibility="Collapsed">
                            <!-- 백돌 베이스 입체 구체 -->
                            <Ellipse Width="150" Height="150">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.32,0.32" GradientOrigin="0.32,0.32" RadiusX="0.75" RadiusY="0.75">
                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                        <GradientStop Color="#F1F5F9" Offset="0.4" />
                                        <GradientStop Color="#CBD5E1" Offset="0.8" />
                                        <GradientStop Color="#64748B" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFFF" Offset="0" />
                                        <GradientStop Color="#94A3B8" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚪" FontSize="44" HorizontalAlignment="Center" Foreground="#38BDF8" />
                                <TextBlock Text="백 (후공)" FontSize="18" FontWeight="Black" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="S E C O N D   M O V E" FontSize="9" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" />
                            </StackPanel>
                            <!-- 반사 하이라이트 -->
                            <Path Data="M 24,42 A 70,70 0 0,1 126,42 A 60,26 0 0,0 24,42"
                                  Fill="#60FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 결과 텍스트 안내 및 참여자 비교 -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                    <Border Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="16" Padding="16,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- 나 -->
                            <TextBlock Text="나: " Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MyNick}" FontWeight="Bold" Foreground="#ECEEFA" VerticalAlignment="Center" />
                            
                            <TextBlock Text="  VS  " FontWeight="Black" Foreground="#F59E0B" VerticalAlignment="Center" Margin="10,0" />

                            <!-- 상대 -->
                            <TextBlock Text="상대: " Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OpponentNick}" FontWeight="Bold" Foreground="#ECEEFA" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 결정된 결과 문구 -->
                    <TextBlock x:Name="ResultDescText"
                               Text="{Binding CoinWinnerDesc}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#34D399"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
