<UserControl x:Class="OmokLan.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:OmokLan.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="600">

    <UserControl.Resources>
        <views:BoolToVisibility x:Key="BoolToVisibility" />
        <views:AvatarToBrushConverter x:Key="AvatarToBrush" />
        <views:AvatarToSymbolConverter x:Key="AvatarToSymbol" />
        <views:NotNullToVisibility x:Key="NotNullToVisibility" />
    </UserControl.Resources>

    <Grid Background="#CC070914">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="500" Background="#F2161A2E"
                BorderBrush="#40FFFFFF" BorderThickness="1"
                CornerRadius="24" Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="50" ShadowDepth="12" Color="#000000" Opacity="0.7" />
            </Border.Effect>

            <StackPanel>
                <!-- 상단 타이틀 -->
                <TextBlock Text="👤 프로필 설정" FontSize="22" FontWeight="Bold" Foreground="#ECEEFA" HorizontalAlignment="Center" />
                <TextBlock Text="네트워크에서 상대방에게 보여질 닉네임과 아바타를 선택하세요."
                           FontSize="13" Foreground="#8C92B8" HorizontalAlignment="Center" Margin="0,6,0,24" />

                <!-- 닉네임 입력 -->
                <TextBlock Text="닉네임 (2~12자)" FontSize="13" FontWeight="SemiBold" Foreground="#ECEEFA" Margin="0,0,0,8" />
                <TextBox Style="{StaticResource Input}" Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" />

                <!-- 오류 메시지 -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FB7185" FontSize="12" Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVisibility}}" />

                <!-- 아바타 선택 그리드 -->
                <TextBlock Text="아바타 선택" FontSize="13" FontWeight="SemiBold" Foreground="#ECEEFA" Margin="0,20,0,12" />

                <ItemsControl ItemsSource="{Binding Avatars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" Rows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="6" Padding="0" Cursor="Hand"
                                    Command="{Binding DataContext.SelectAvatarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Id}"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <!-- 선택 시 외곽 하이라이트 -->
                                            <Border x:Name="SelectionRing" CornerRadius="18" BorderThickness="3" BorderBrush="Transparent" Margin="-4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{x:Null}">
                                                                        <!-- 간편한 처리를 위해 템플릿 트리거 사용 -->
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- 아바타 뱃지 본체 -->
                                            <Border x:Name="AvatarCard" CornerRadius="16" Background="#1E2340"
                                                    BorderBrush="#33FFFFFF" BorderThickness="1" Padding="10">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="60" Height="60" CornerRadius="30"
                                                            Background="{Binding Id, Converter={StaticResource AvatarToBrush}}">
                                                        <TextBlock Text="{Binding Symbol}" FontSize="28"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#ECEEFA" Margin="0,6,0,0"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AvatarCard" Property="Background" Value="#2A3156" />
                                                <Setter TargetName="AvatarCard" Property="BorderBrush" Value="#8B5CF6" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 선택된 아바타 프리뷰 -->
                <Border Background="#12FFFFFF" CornerRadius="14" Padding="12" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="현재 선택: " Foreground="#8C92B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{Binding SelectedAvatarId, Converter={StaticResource AvatarToBrush}}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding SelectedAvatarId, Converter={StaticResource AvatarToSymbol}}"
                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Nickname}" FontWeight="Bold" Foreground="#ECEEFA" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 하단 버튼 (확인 / 취소) -->
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="취소" Style="{StaticResource Btn.Ghost}"
                            Command="{Binding DataContext.CancelProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding DataContext.IsFirstTimeSetup, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter='!'}" />

                    <Button Grid.Column="2" Content="저장 및 시작" Style="{StaticResource Btn.Primary}"
                            Command="{Binding DataContext.SaveProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
