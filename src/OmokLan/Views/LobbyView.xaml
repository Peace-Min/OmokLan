<UserControl x:Class="OmokLan.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:OmokLan.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="960">

    <UserControl.Resources>
        <views:BoolToVisibility x:Key="BoolToVisibility" />
        <views:PresenceToBrush x:Key="PresenceToBrush" />
        <views:PresenceToText x:Key="PresenceToText" />
        <views:AvatarToBrushConverter x:Key="AvatarToBrush" />
        <views:AvatarToSymbolConverter x:Key="AvatarToSymbol" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 상단 헤더 & 내 상태 컨트롤 바 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌐 LAN 네트워크 로비" FontSize="20" FontWeight="Bold" Foreground="#ECEEFA" VerticalAlignment="Center" />
                    <Border Background="#20FFFFFF" CornerRadius="12" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Peers.Count, StringFormat='접속자 {0}명'}"
                                       FontSize="12" Foreground="#8C92B8" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 우측 컨트롤: AI 난이도 선택 + 연습 봇 소환 + DND 토글 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- AI 난이도 선택 그룹 -->
                    <Border Background="#1A2038" BorderBrush="#2A3156" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AI 난이도:" FontSize="11" FontWeight="Bold" Foreground="#8C92B8" VerticalAlignment="Center" Margin="2,0,8,0" />
                            <RadioButton Content="초급" GroupName="DifficultyGroup" IsChecked="{Binding IsEasy, Mode=OneWay}"
                                         Command="{Binding SelectDifficultyCommand}" CommandParameter="Easy"
                                         Foreground="#ECEEFA" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <RadioButton Content="중급" GroupName="DifficultyGroup" IsChecked="{Binding IsNormal, Mode=OneWay}"
                                         Command="{Binding SelectDifficultyCommand}" CommandParameter="Normal"
                                         Foreground="#ECEEFA" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <RadioButton Content="고급" GroupName="DifficultyGroup" IsChecked="{Binding IsHard, Mode=OneWay}"
                                         Command="{Binding SelectDifficultyCommand}" CommandParameter="Hard"
                                         Foreground="#ECEEFA" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource Btn.Ghost}" Margin="0,0,16,0" Padding="12,6"
                            Command="{Binding ToggleBotCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IsBotActive, Converter={StaticResource BoolToVisibility}, ConverterParameter='!'}" Visibility="Collapsed" />
                            <TextBlock Text="🤖 연습 상대 소환" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                       Visibility="{Binding IsBotActive, Converter={StaticResource BoolToVisibility}, ConverterParameter='!'}" />
                            <TextBlock Text="❌ 연습 상대 퇴장" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#FB7185"
                                       Visibility="{Binding IsBotActive, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="방해금지 모드" FontSize="13" Foreground="#ECEEFA" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IsDnd}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 피어 목록 카드 그리드 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <!-- 접속자 없을 때 빈 안내 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Peers.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter='!'}">
                    <TextBlock Text="📡" FontSize="48" HorizontalAlignment="Center" Opacity="0.6" />
                    <TextBlock Text="같은 LAN 네트워크에서 접속 중인 사용자를 탐색하고 있습니다..."
                               FontSize="16" FontWeight="SemiBold" Foreground="#8C92B8"
                               HorizontalAlignment="Center" Margin="0,16,0,6" />
                    <TextBlock Text="상대방이 앱을 실행하면 자동으로 목록에 나타납니다."
                               FontSize="13" Foreground="#555C85" HorizontalAlignment="Center" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="🌱 AI 초급 대결" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" Padding="14,9"
                                Command="{Binding SelectDifficultyCommand}" CommandParameter="Easy" />
                        <Button Content="⚔️ AI 중급 대결" Style="{StaticResource Btn.Primary}" Margin="0,0,8,0" Padding="16,9"
                                Command="{Binding SelectDifficultyCommand}" CommandParameter="Normal" />
                        <Button Content="🔥 AI 고급 대결" Style="{StaticResource Btn.Ghost}" Padding="14,9"
                                Command="{Binding SelectDifficultyCommand}" CommandParameter="Hard" />
                    </StackPanel>
                </StackPanel>

                <!-- 목록 리스트 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Peers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="280" Background="#161A2E" BorderBrush="#2A3156" BorderThickness="1"
                                        CornerRadius="16" Padding="16" Margin="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="4" Color="#000000" Opacity="0.3" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 유저 아바타 + 닉네임 + IP + 상태 뱃지 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 아바타 뱃지 -->
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                                    Background="{Binding Avatar, Converter={StaticResource AvatarToBrush}}"
                                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Avatar, Converter={StaticResource AvatarToSymbol}}"
                                                           FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- 닉네임 및 IP -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nick}" FontSize="15" FontWeight="Bold"
                                                           Foreground="#ECEEFA" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Address}" FontSize="11" Foreground="#8C92B8" Margin="0,2,0,4" />

                                                <!-- 상태 뱃지 -->
                                                <Border Style="{StaticResource Pill}"
                                                        Background="#20FFFFFF"
                                                        BorderBrush="{Binding Status, Converter={StaticResource PresenceToBrush}}"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="{Binding Status, Converter={StaticResource PresenceToBrush}}"
                                                                 Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Status, Converter={StaticResource PresenceToText}}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding Status, Converter={StaticResource PresenceToBrush}}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 대결 신청 버튼 -->
                                        <Button Grid.Row="1" Content="⚔️ 대결 신청" Style="{StaticResource Btn.Primary}"
                                                Margin="0,14,0,0"
                                                IsEnabled="{Binding CanChallenge}"
                                                Command="{Binding DataContext.ChallengeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 대결 신청 진행 중 오버레이 -->
        <Grid Grid.RowSpan="2" Background="#D0080B16"
              Visibility="{Binding IsChallenging, Converter={StaticResource BoolToVisibility}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="400" Background="#F2161A2E" BorderBrush="#8B5CF6" BorderThickness="1.5"
                    CornerRadius="24" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#8B5CF6" Opacity="0.5" />
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚔️" FontSize="44" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ChallengingNick, StringFormat='{}{0} 님에게 대결을 신청했습니다'}"
                               FontSize="17" FontWeight="Bold" Foreground="#ECEEFA"
                               HorizontalAlignment="Center" Margin="0,14,0,6" />
                    <TextBlock Text="상대방의 수락을 기다리는 중입니다..."
                               FontSize="13" Foreground="#8C92B8" HorizontalAlignment="Center" />

                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,20,0,20" Foreground="#8B5CF6" Background="#20FFFFFF" />

                    <Button Content="신청 취소" Style="{StaticResource Btn.Ghost}"
                            Command="{Binding CancelChallengeCommand}" HorizontalAlignment="Center" Width="140" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 대결 신청 수신 팝업 모달 -->
        <Grid Grid.RowSpan="2" Background="#D0080B16"
              Visibility="{Binding HasIncomingChallenge, Converter={StaticResource BoolToVisibility}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="440" Background="#F2161A2E" BorderBrush="#38BDF8" BorderThickness="2"
                    CornerRadius="24" Padding="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" Color="#38BDF8" Opacity="0.6" />
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center">
                    <Border Width="68" Height="68" CornerRadius="34"
                            Background="{Binding IncomingAvatar, Converter={StaticResource AvatarToBrush}}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding IncomingAvatar, Converter={StaticResource AvatarToSymbol}}"
                                   FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{Binding IncomingNick, StringFormat='{}{0} 님의 대결 신청!'}"
                               FontSize="20" FontWeight="Bold" Foreground="#ECEEFA"
                               HorizontalAlignment="Center" Margin="0,16,0,6" />

                    <TextBlock Text="오목 대결을 수락하시겠습니까?"
                               FontSize="14" Foreground="#8C92B8" HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding IncomingRemainingSeconds, StringFormat='남은 시간: {0}초'}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#FBBF24"
                               HorizontalAlignment="Center" Margin="0,10,0,24" />

                    <!-- 수락 / 거절 버튼 -->
                    <Grid Width="340">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="거절" Style="{StaticResource Btn.Danger}"
                                Command="{Binding DeclineIncomingCommand}" />

                        <Button Grid.Column="2" Content="수락" Style="{StaticResource Btn.Success}"
                                Command="{Binding AcceptIncomingCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
